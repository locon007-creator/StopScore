{
  "name": "stopscore-driver-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:v2 && npm run build && node --test tests/*.test.mjs",
    "test:v2": "npm run typecheck:v2 && node --test tests/v2-*.test.ts && node --import tsx --test tests/v2-*.test.tsx",
    "typecheck:v2": "tsc -p tsconfig.v2.json --pretty false && tsc -p tsconfig.v2-tests.json --pretty false",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "mcp:test": "npm test --prefix tools/stopscore-mcp",
    "mcp:typecheck": "npm run typecheck --prefix tools/stopscore-mcp",
    "mcp:start": "npm start --prefix tools/stopscore-mcp",
    "mcp:start:http": "npm run start:http --prefix tools/stopscore-mcp"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "react-test-renderer": "^19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  },
  "type": "module",
  "displayName": "StopScore Driver OS"
}
